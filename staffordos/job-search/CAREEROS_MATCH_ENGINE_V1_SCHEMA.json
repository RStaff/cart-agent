{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "staffordos.careeros.match_engine.v1",
  "title": "CareerOS Match Engine V1 result contract",
  "type": "object",
  "required": ["opportunityId", "opportunityIdentity", "eligibility", "qualification", "requirementSummary", "evidenceSummary", "fit", "confidence", "preferences", "recommendation", "workflow", "application"],
  "properties": {
    "opportunityId": {"type": "string"},
    "opportunityIdentity": {"$ref": "#/$defs/opportunityIdentity"},
    "sourceProvider": {"type": ["string", "null"]},
    "sourceJobId": {"type": ["string", "null"]},
    "canonicalUrl": {"type": ["string", "null"], "format": "uri"},
    "company": {"type": "string"},
    "title": {"type": "string"},
    "location": {"type": ["string", "null"]},
    "workArrangement": {"enum": ["REMOTE", "HYBRID", "ON_SITE", "UNKNOWN", null]},
    "employmentType": {"type": ["string", "null"]},
    "compensation": {"type": ["string", "null"]},
    "capturedAt": {"type": ["string", "null"], "format": "date-time"},
    "freshnessState": {"enum": ["CURRENT", "RECENT", "STALE", "UNKNOWN"]},
    "eligibility": {"$ref": "#/$defs/eligibility"},
    "qualification": {"$ref": "#/$defs/qualification"},
    "requirementSummary": {"$ref": "#/$defs/countSummary"},
    "evidenceSummary": {"$ref": "#/$defs/evidenceSummary"},
    "fit": {"$ref": "#/$defs/fit"},
    "confidence": {"$ref": "#/$defs/confidence"},
    "preferences": {"$ref": "#/$defs/preferences"},
    "recommendation": {"$ref": "#/$defs/recommendation"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "application": {"$ref": "#/$defs/application"}
  },
  "$defs": {
    "opportunityIdentity": {"type": "object", "required": ["canonicalOpportunityId", "sourceRecordId"], "properties": {"canonicalOpportunityId": {"type": ["string", "null"]}, "sourceRecordId": {"type": ["string", "null"]}, "providerJobId": {"type": ["string", "null"]}, "provenance": {"type": "string"}}, "additionalProperties": false},
    "eligibility": {"type": "object", "required": ["state", "blockingReasons"], "properties": {"state": {"enum": ["ELIGIBLE", "INELIGIBLE", "REVIEW_REQUIRED", "UNKNOWN"]}, "blockingReasons": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "qualification": {"type": "object", "required": ["state", "reasons"], "properties": {"state": {"enum": ["PLAUSIBLE_TARGET", "TRANSFERABLE_BUT_NOT_DIRECT", "INSUFFICIENT_EVIDENCE", "HARD_MISMATCH", "UNKNOWN"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "hardMismatchCategories": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "countSummary": {"type": "object", "required": ["mandatoryCount", "preferredCount", "supportedMandatoryCount", "unsupportedMandatoryCount", "supportedPreferredCount", "unsupportedPreferredCount"], "properties": {"mandatoryCount": {"type": "integer", "minimum": 0}, "preferredCount": {"type": "integer", "minimum": 0}, "supportedMandatoryCount": {"type": "integer", "minimum": 0}, "unsupportedMandatoryCount": {"type": "integer", "minimum": 0}, "supportedPreferredCount": {"type": "integer", "minimum": 0}, "unsupportedPreferredCount": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "evidenceSummary": {"type": "object", "required": ["exactEvidenceCount", "transferableEvidenceCount", "weakEvidenceCount", "unsupportedCount"], "properties": {"exactEvidenceCount": {"type": "integer", "minimum": 0}, "transferableEvidenceCount": {"type": "integer", "minimum": 0}, "weakEvidenceCount": {"type": "integer", "minimum": 0}, "unsupportedCount": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "fit": {"type": "object", "required": ["score", "scoreStatus", "components", "explanation"], "properties": {"score": {"type": ["number", "null"]}, "scoreStatus": {"enum": ["NOT_IMPLEMENTED", "PARTIAL", "CALCULATED"]}, "components": {"type": "array", "items": {"type": "object", "required": ["name", "value", "status"], "properties": {"name": {"type": "string"}, "value": {}, "status": {"enum": ["NOT_IMPLEMENTED", "PARTIAL", "CALCULATED", "UNKNOWN"]}, "evidence": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}}, "explanation": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "confidence": {"type": "object", "required": ["score", "scoreStatus", "missingInputs", "explanation"], "properties": {"score": {"type": ["number", "null"]}, "scoreStatus": {"enum": ["NOT_IMPLEMENTED", "PARTIAL", "CALCULATED"]}, "missingInputs": {"type": "array", "items": {"type": "string"}}, "explanation": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "preferences": {"type": "object", "required": ["compatibility", "reasons"], "properties": {"compatibility": {"enum": ["MATCH", "PARTIAL_MATCH", "OUTSIDE_PREFERENCE", "UNKNOWN"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "authorityState": {"type": "string"}}, "additionalProperties": false},
    "recommendation": {"type": "object", "required": ["state", "reasons"], "properties": {"state": {"enum": ["APPLY_NOW", "REVIEW", "WAIT", "SKIP", "NOT_RECOMMENDED", "UNKNOWN"]}, "reasons": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "workflow": {"type": "object", "required": ["rossDecision", "decidedAt"], "properties": {"rossDecision": {"enum": ["APPLY", "REVIEW_LATER", "SKIP", "NOT_INTERESTED", "UNDECIDED", "UNKNOWN"]}, "decidedAt": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
    "application": {"type": "object", "required": ["state", "resumeStatus", "submissionStatus"], "properties": {"state": {"type": "string"}, "resumeStatus": {"type": "string"}, "submissionStatus": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
