  "warning_language": {
    "must_explain": [
      "what is wrong",
      "what it affects",
      "whether work can continue",
      "what the operator should do next"
    ],
    "technical_details_policy": "Raw file paths, enum names, stack details, missing JSON filenames, and implementation errors belong in secondary technical details, not as the primary message."
  },
  "ai_recommendation_language": {
    "required_fields": [
      "What to do",
      "Why now",
      "Evidence",
      "Expected result",
      "Risk or uncertainty",
      "Required approval",
      "What completion will prove"
    ],
    "certainty_policy": "Avoid unsupported certainty. State uncertainty when evidence is incomplete."
  },
