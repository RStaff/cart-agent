  "language_boundaries": {
    "operator_facing_ui": {
      "use": [
        "business outcomes",
        "next actions",
        "evidence",
        "risks",
        "approvals",
        "deadlines"
      ],
      "avoid": [
        "raw enum names",
        "file paths as primary messages",
        "stack traces",
        "unexplained authority jargon"
      ]
    },
    "internal_architecture": {
      "use": [
        "canonical terms",
        "system boundaries",
        "models",
        "route strategy",
        "authority names"
      ],
      "avoid": [
        "casual renames that obscure source-of-truth meaning"
      ]
    },
    "developer_debug": {
      "use": [
        "file paths",
        "API routes",
        "enum values",
        "validator output",
        "raw maps"
      ],
      "avoid": [
        "presenting debug labels as primary operator guidance"
      ]
    },
    "governance": {
      "use": [
        "authority",
        "audit",
        "approval",
        "proof",
        "fingerprint",
        "immutable state"
      ],
      "avoid": [
        "hiding required gates"
      ]
    },
    "customer_facing": {
      "use": [
        "merchant benefit",
        "proof",
        "scope",
        "price",
        "next customer step"
      ],
      "avoid": [
        "internal StaffordOS terminology",
        "AI-agent internals",
        "Packet language"
      ]
    }
