  "action_language": {
    "rules": [
      "Start with a verb.",
      "Name the object.",
      "Avoid vague system verbs.",
      "Match the consequence.",
      "Add approval language when the action is governed."
    ],
    "prefer": [
      "Contact this lead",
      "Review the proposal",
      "Open payment details",
      "Start today's work",
      "See why this matters",
      "Mark as complete",
      "Ask for approval",
      "Review proof"
    ],
    "avoid": [
      "Execute",
      "Process",
      "Submit action",
      "Run operation",
      "Open module",
      "Manage entity"
    ]
  },
