  "firstStaticUseCases": [
    {
      "useCase": "Explain the current static primary Action",
      "operatorQuestion": "What should I look at first?",
      "allowedSources": ["Workspace Registry", "Capability Registry", "Action Registry", "Objective Registry", "Evidence Foundation", "Proof Foundation"],
      "expectedOutput": "Candidate explanation for Start My Day with sources.",
      "unsupportedClaimsToReject": ["live ranking", "AI selection", "deadline", "metric"],
      "authorityStatus": "Informational only",
      "proofOfCorrectBehavior": "Claim traces to static Action and Evidence."
    },
    {
      "useCase": "Summarize current Objectives",
      "operatorQuestion": "What are we working toward?",
      "allowedSources": ["Objective Registry", "StaffordOS architecture documents"],
      "expectedOutput": "Three Stafford Media Objectives and limitations.",
      "unsupportedClaimsToReject": ["live progress", "revenue", "completion"],
      "authorityStatus": "Informational only",
      "proofOfCorrectBehavior": "Each Objective traces to source artifacts."
    },
    {
      "useCase": "Explain a Decision and Evidence",
      "operatorQuestion": "Why is /operator still the working source?",
      "allowedSources": ["Decision Registry", "Evidence Foundation", "S008.01", "S008.14"],
      "expectedOutput": "Decision rationale and supporting sources.",
      "unsupportedClaimsToReject": ["approval to migrate", "redirect authority"],
      "authorityStatus": "Informational only",
      "proofOfCorrectBehavior": "Decision ID and Evidence IDs are cited."
    },
    {
      "useCase": "Show what has and has not been proven",
      "operatorQuestion": "What do we know worked?",
      "allowedSources": ["Proof Foundation", "Evidence Foundation"],
      "expectedOutput": "Narrow Proof summaries and not-proven limits.",
      "unsupportedClaimsToReject": ["business outcome verification"],
      "authorityStatus": "Informational only",
      "proofOfCorrectBehavior": "Expected result remains separate from observed outcome."
    },
    {
      "useCase": "Retrieve relevant Learning",
      "operatorQuestion": "What should StaffordOS remember here?",
      "allowedSources": ["Learning Foundation", "Proof Foundation"],
      "expectedOutput": "Confirmed Learning with applicability and limits.",
      "unsupportedClaimsToReject": ["policy creation", "automatic priority change"],
      "authorityStatus": "Informational only",
      "proofOfCorrectBehavior": "Learning references supporting Proof."
    }
  ],
