{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "staffordos.deployment_authority_certificate.v1",
  "$comment": "Generic validation policy only. Certificate-instance data (audience, forge, repository, branch, commit, roots, provider bindings, database policy) is supplied by the candidate document, never by this schema. The signature envelope carries an algorithm, a trusted-key identifier and a base64url signature only; key material and trust decisions live exclusively with the consuming gate. Every object is closed, every string is bounded, and every keyword used here is enforced at runtime by deployment_authority_certificate_v1.mjs.",
  "$ref": "#/$defs/certificate",
  "$defs": {
    "sha1Hex": { "type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40 },
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64 },
    "utf8Hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2}){1,1024}$", "maxLength": 2048 },
    "byteLength": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "utcTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "maxLength": 24 },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "maxLength": 64 },
    "forgeHost": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$", "maxLength": 253 },
    "roleName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "maxLength": 64 },
    "providerName": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$", "maxLength": 64 },
    "databasePolicy": { "type": "string", "enum": ["required", "none"] },
    "branchShortName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$", "maxLength": 255 },
    "branchFullRef": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$", "maxLength": 266 },
    "repositoryPath": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 1024 },
    "treeEntryMode": { "type": "string", "pattern": "^[0-7]{6}$", "maxLength": 6 },
    "treeEntryType": { "type": "string", "enum": ["tree", "blob", "commit"] },
    "comparedValue": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,1024}$", "maxLength": 1024 },
    "fieldPath": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*|\\[[0-9]{1,3}\\])*$", "maxLength": 128 },
    "audience": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$", "maxLength": 128 },
    "signatureAlgorithm": { "type": "string", "enum": ["Ed25519"] },
    "signatureValue": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$", "maxLength": 86 },

    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forgeHost", "name", "owner"],
      "properties": {
        "forgeHost": { "$ref": "#/$defs/forgeHost" },
        "owner": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forgeHost", "name", "owner", "remoteName"],
      "properties": {
        "forgeHost": { "$ref": "#/$defs/forgeHost" },
        "owner": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "remoteName": { "$ref": "#/$defs/identifier" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullRef", "nameByteLength", "nameUtf8Hex", "shortName"],
      "properties": {
        "shortName": { "$ref": "#/$defs/branchShortName" },
        "fullRef": { "$ref": "#/$defs/branchFullRef" },
        "nameUtf8Hex": { "$ref": "#/$defs/utf8Hex" },
        "nameByteLength": { "$ref": "#/$defs/byteLength" }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "treeSha"],
      "properties": {
        "sha": { "$ref": "#/$defs/sha1Hex" },
        "treeSha": { "$ref": "#/$defs/sha1Hex" }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pathByteLength", "pathUtf8Hex", "role", "treeObjectSha"],
      "properties": {
        "role": { "$ref": "#/$defs/roleName" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "pathUtf8Hex": { "$ref": "#/$defs/utf8Hex" },
        "pathByteLength": { "$ref": "#/$defs/byteLength" },
        "treeObjectSha": { "$ref": "#/$defs/sha1Hex" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "id", "region", "repository", "rootDirectory", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/identifier" },
        "repository": { "$ref": "#/$defs/repositoryIdentity" },
        "branch": { "$ref": "#/$defs/branchShortName" },
        "rootDirectory": { "$ref": "#/$defs/repositoryPath" },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "region"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "databasePolicy", "databases", "name", "services"],
      "properties": {
        "name": { "$ref": "#/$defs/providerName" },
        "accountId": { "$ref": "#/$defs/identifier" },
        "databasePolicy": { "$ref": "#/$defs/databasePolicy" },
        "services": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/service" } },
        "databases": { "type": "array", "minItems": 0, "maxItems": 32, "items": { "$ref": "#/$defs/database" } }
      }
    },

    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "branch", "candidatePayloadSha256", "candidateVersion", "commit", "provider", "repository", "roots"],
      "properties": {
        "candidateVersion": { "type": "string", "const": "staffordos.deployment_authority_candidate.v1" },
        "audience": { "$ref": "#/$defs/audience" },
        "repository": { "$ref": "#/$defs/repository" },
        "branch": { "$ref": "#/$defs/branch" },
        "commit": { "$ref": "#/$defs/commit" },
        "roots": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/root" } },
        "provider": { "$ref": "#/$defs/provider" },
        "candidatePayloadSha256": { "$ref": "#/$defs/sha256Hex" }
      }
    },

    "gitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullRef", "sha"],
      "properties": {
        "fullRef": { "$ref": "#/$defs/branchFullRef" },
        "sha": { "$ref": "#/$defs/sha1Hex" }
      }
    },
    "gitTreeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "objectSha", "path", "type"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "mode": { "$ref": "#/$defs/treeEntryMode" },
        "type": { "$ref": "#/$defs/treeEntryType" },
        "objectSha": { "$ref": "#/$defs/sha1Hex" }
      }
    },
    "gitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "observedAtUtc", "ref", "remoteName", "repository", "roots"],
      "properties": {
        "observedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "repository": { "$ref": "#/$defs/repositoryIdentity" },
        "remoteName": { "$ref": "#/$defs/identifier" },
        "ref": { "$ref": "#/$defs/gitRef" },
        "commit": { "$ref": "#/$defs/commit" },
        "roots": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/gitTreeEntry" } }
      }
    },

    "observedService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "id", "region", "repository", "requestedId", "rootDirectory", "type"],
      "properties": {
        "requestedId": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/identifier" },
        "repository": { "$ref": "#/$defs/repositoryIdentity" },
        "branch": { "$ref": "#/$defs/branchShortName" },
        "rootDirectory": { "$ref": "#/$defs/repositoryPath" },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "observedDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "region", "requestedId"],
      "properties": {
        "requestedId": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "providerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "databases", "name", "observedAtUtc", "services"],
      "properties": {
        "observedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "name": { "$ref": "#/$defs/providerName" },
        "accountId": { "$ref": "#/$defs/identifier" },
        "services": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/observedService" } },
        "databases": { "type": "array", "minItems": 0, "maxItems": 32, "items": { "$ref": "#/$defs/observedDatabase" } }
      }
    },

    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "field", "observed"],
      "properties": {
        "field": { "$ref": "#/$defs/fieldPath" },
        "expected": { "$ref": "#/$defs/comparedValue" },
        "observed": { "$ref": "#/$defs/comparedValue" }
      }
    },

    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "$ref": "#/$defs/signatureAlgorithm" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/signatureValue" }
      }
    },

    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "certificatePayloadSha256", "certificateVersion", "generatedAtUtc", "gitEvidence", "mismatches", "providerEvidence", "signature", "status"],
      "properties": {
        "certificateVersion": { "type": "string", "const": "staffordos.deployment_authority_certificate.v1" },
        "generatedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "gitEvidence": { "$ref": "#/$defs/gitEvidence" },
        "providerEvidence": { "$ref": "#/$defs/providerEvidence" },
        "mismatches": { "type": "array", "minItems": 0, "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/mismatch" } },
        "status": { "type": "string", "enum": ["PASS", "STALE", "MISMATCH"] },
        "certificatePayloadSha256": { "$ref": "#/$defs/sha256Hex" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
