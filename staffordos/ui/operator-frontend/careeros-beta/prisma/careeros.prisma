generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CareerUser {
  id           String                   @id @default(cuid())
  email        String                   @unique
  passwordHash String
  passwordSalt String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships  CareerTenantMembership[]
  sessions     CareerSession[]
  profiles     CareerProfile[]
  auditEvents  CareerAuditEvent[]
  opportunityEvents CareerOpportunityEvent[]
  opportunityNotes CareerOpportunityNote[]
}

model CareerTenant {
  id          String                     @id @default(cuid())
  name        String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  memberships CareerTenantMembership[]
  profiles    CareerProfile[]
  sources     CareerSource[]
  candidates  CareerFactCandidate[]
  reviews     CareerFactReviewDecision[]
  facts       CareerFact[]
  onboarding  CareerOnboardingState[]
  auditEvents CareerAuditEvent[]
  opportunityEvents CareerOpportunityEvent[]
  opportunityNotes CareerOpportunityNote[]
  sessions    CareerSession[]
  capabilities CareerCapabilityAuthority[]
  capabilityDecisions CareerCapabilityDecision[]
  opportunities CareerOpportunity[]
  requirements CareerOpportunityRequirement[]
  matchEvaluations CareerMatchEvaluation[]
  resumeDrafts CareerResumeDraft[]
  inboxItems CareerOpportunityInboxItem[]
  searchPreferences CareerSearchPreference[]
}

model CareerTenantMembership {
  id        String       @id @default(cuid())
  tenantId  String
  userId    String
  role      String       @default("OWNER")
  createdAt DateTime     @default(now())
  tenant    CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      CareerUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, role])
}

model CareerProfile {
  id          String                 @id @default(cuid())
  tenantId    String
  userId      String
  displayName String
  headline    String?
  location    String?
  careerStage String?
  status      String                 @default("ACTIVE")
  version     Int                    @default(1)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      CareerTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        CareerUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources     CareerSource[]
  candidates  CareerFactCandidate[]
  facts       CareerFact[]
  onboarding  CareerOnboardingState?
  capabilities CareerCapabilityAuthority[]
  opportunities CareerOpportunity[]
  matchEvaluations CareerMatchEvaluation[]
  resumeDrafts CareerResumeDraft[]
  inboxItems CareerOpportunityInboxItem[]
  searchPreferences CareerSearchPreference[]

  @@unique([tenantId, userId])
  @@index([userId, updatedAt])
}

model CareerSource {
  id               String                @id @default(cuid())
  tenantId         String
  userId           String
  profileId        String
  sourceType       String
  sourceStatus     String
  originalFilename String?
  contentReference String?
  sourceDigest     String?
  extractorVersion String?
  textContent      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           CareerTenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile          CareerProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  candidates       CareerFactCandidate[]

  @@index([tenantId, userId, updatedAt])
  @@index([profileId, createdAt])
  @@index([tenantId, sourceDigest, extractorVersion])
}

model CareerFactCandidate {
  id                String                     @id @default(cuid())
  candidateFactId   String                     @unique
  tenantId          String
  userId            String
  profileId         String
  sourceId          String
  factType          String
  statement         String
  sourceExcerpt     String
  sourceOrder       Int
  scopeStatement    String?
  extractionMethod  String
  extractionVersion String
  confidence        String
  ambiguity         Json
  status            String                     @default("PROPOSED")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  tenant            CareerTenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile           CareerProfile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source            CareerSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  reviews           CareerFactReviewDecision[]
  facts             CareerFact[]

  @@unique([sourceId, extractionVersion, sourceOrder])
  @@index([tenantId, userId, status])
}

model CareerFactReviewDecision {
  id                String              @id @default(cuid())
  tenantId          String
  userId            String
  candidateFactId   String
  decision          String
  previousStatement String?
  activeStatement   String?
  createdAt         DateTime            @default(now())
  tenant            CareerTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate         CareerFactCandidate @relation(fields: [candidateFactId], references: [id], onDelete: Cascade)

  @@index([tenantId, candidateFactId, createdAt])
}

model CareerFact {
  id              String              @id @default(cuid())
  candidateFactId String              @unique
  tenantId        String
  userId          String
  profileId       String
  sourceId        String
  factType        String
  statement       String
  sourceExcerpt   String
  sourceOrder     Int
  scopeStatement  String?
  authorityState  String
  status          String              @default("CUSTOMER_CONFIRMED")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          CareerTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile         CareerProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  candidate       CareerFactCandidate @relation(fields: [candidateFactId], references: [candidateFactId], onDelete: Cascade)

  @@index([tenantId, userId, updatedAt])
  @@index([profileId, createdAt])
}

model CareerSession {
  id          String       @id @default(cuid())
  tokenDigest String       @unique
  userId      String
  tenantId    String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  user        CareerUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tenantId, revokedAt])
}

model CareerOnboardingState {
  id        String        @id @default(cuid())
  tenantId  String
  profileId String        @unique
  stage     String        @default("PROFILE")
  updatedAt DateTime      @updatedAt
  tenant    CareerTenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile   CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([tenantId, stage])
}

model CareerAuditEvent {
  id         String       @id @default(cuid())
  tenantId   String
  userId     String
  eventType  String
  requestId  String?
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  tenant     CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       CareerUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, eventType, createdAt])
}

model CareerInvite {
  id          String    @id
  email       String
  tokenDigest String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, expiresAt])
}

model CareerRateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model CareerCapabilityAuthority {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  profileId       String
  capabilityKey   String
  label           String
  domain          String
  scope           String
  authorityState  String
  provenance      Json
  taxonomyVersion String
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  decisions       CareerCapabilityDecision[]

  @@unique([tenantId, profileId, capabilityKey])
  @@index([tenantId, userId, authorityState])
}

model CareerCapabilityDecision {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  capabilityId  String
  questionKey   String
  answer        String
  decisionState String
  rationale     String?
  taxonomyVersion String
  createdAt     DateTime @default(now())
  supersededAt  DateTime?
  tenant        CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability   CareerCapabilityAuthority @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([tenantId, capabilityId, createdAt])
  @@index([tenantId, questionKey, supersededAt])
}

model CareerOpportunity {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  profileId       String
  sourceType      String
  title           String
  company         String?
  location        String?
  description     String
  sourceUrl       String?
  decisionState   String   @default("CONSIDERING")
  lifecycleState  String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile         CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  requirements    CareerOpportunityRequirement[]
  evaluations     CareerMatchEvaluation[]
  resumeDrafts    CareerResumeDraft[]
  inboxItems      CareerOpportunityInboxItem[]
  events          CareerOpportunityEvent[]
  notes           CareerOpportunityNote[]

  @@index([tenantId, userId, updatedAt])
}

model CareerOpportunityEvent {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  opportunityId String
  eventType     String
  metadata      Json?
  createdAt     DateTime @default(now())
  tenant        CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          CareerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, opportunityId, createdAt])
  @@index([tenantId, userId, createdAt])
}

model CareerOpportunityNote {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  opportunityId String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          CareerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, opportunityId, createdAt])
}

model CareerOpportunityInboxItem {
  id                    String   @id @default(cuid())
  tenantId              String
  userId                String
  profileId             String
  sourceType            String
  sourceName            String?
  sourceUrl             String?
  externalOpportunityId String?
  discoveredAt          DateTime?
  importedAt            DateTime @default(now())
  title                 String
  company               String?
  location              String?
  description           String?
  provenance            Json?
  normalizedDigest      String?
  normalizedUrl         String?
  normalizationStatus   String   @default("NORMALIZED")
  duplicateStatus       String   @default("NEW")
  status                String   @default("READY_TO_ANALYZE")
  duplicateOfInboxItemId String?
  opportunityId         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile               CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  opportunity           CareerOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, status, updatedAt])
  @@index([tenantId, normalizedDigest])
  @@index([tenantId, normalizedUrl])
}

model CareerSearchPreference {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  keywords         String   @default("")
  location         String   @default("")
  remotePreference String   @default("any")
  postedWithinDays Int?
  salaryMin        Int?
  resultLimit      Int      @default(10)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             CareerUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, userId, active])
}

model CareerOpportunityRequirement {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  sourceOrder   Int
  text          String
  conceptKey    String
  importance    String
  scope         String
  specialist    Boolean  @default(false)
  createdAt     DateTime @default(now())
  tenant        CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity   CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, sourceOrder])
  @@index([tenantId, opportunityId])
}

model CareerMatchEvaluation {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  profileId        String
  opportunityId    String
  taxonomyVersion  String
  evaluationVersion String
  summary          Json
  relationships    Json
  stale            Boolean  @default(false)
  createdAt        DateTime @default(now())
  tenant           CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile          CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  opportunity      CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, opportunityId, createdAt])
  @@index([tenantId, profileId, stale])
}

model CareerResumeDraft {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  profileId         String
  opportunityId     String
  materialType      String   @default("RESUME")
  generationMethod  String   @default("DETERMINISTIC")
  provider          String?
  model             String?
  evaluationVersion String
  authorityVersion  Int      @default(1)
  draftVersion      Int      @default(1)
  content           Json
  stale             Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            CareerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile           CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  opportunity       CareerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, opportunityId, createdAt])
}
