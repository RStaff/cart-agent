# =========================
# STAFFORDOS PRIVATE DATA BACKSTOP
# =========================
# StaffordOS private user/runtime data must remain outside this repository,
# typically under $HOME/.staffordos/private/ or $HOME/staffordos-private-intake/.
# These rules are defense in depth for accidental in-repository copies. Ignored
# private data is still in a prohibited repository location and must not be used
# as source, architecture, fixtures, or governed evidence.
/.staffordos/
**/.staffordos/private/
/staffordos-private-intake/
**/staffordos-private-intake/
**/private-intake/
**/private-runtime/
**/private-data/
*.private.json
*.private.ndjson
*.private.jsonl
*.private.sqlite
*.private.db
*.private.log

# =========================
# EDITOR / OS
# =========================
.vscode/
.idea/

# =========================
# OPTIONAL: CACHE
# =========================
.cache/

# StaffordOS runtime / generated outputs
staffordos/system_inventory/output/
staffordos/system_inventory/runtime_truth_v2.json
staffordos/operating_loop/output/stop_workday_*/

# Hygiene outputs
staffordos/hygiene/output/

# Agent logs
staffordos/agents/*.json


